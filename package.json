{
  "name": "jt-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/resolve-local-dependencies.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "icons:generate": "node scripts/generate-icons.mjs",
    "preview": "vite preview",
    "test": "vite build && node --import tsx --test --test-concurrency=1 test/*.test.mjs",
    "test:pwa": "vite build && node --test test/pwa.e2e.test.mjs",
    "test:unit": "node --test test/records.test.mjs test/match.test.mjs",
    "test:e2e": "node --test test/e2e.test.mjs"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "puppeteer-core": "^25.6.0",
    "tsx": "^4.23.12",
    "vite": "8.2.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@jt/glass": "file:../jt-glass",
    "jt-connectors": "file:../jt-connectors",
    "jt-core": "file:../jt-core/pkg",
    "jt-sync": "file:../jt-sync",
    "jt-water": "file:../jt-water",
    "pdfjs-dist": "^6.2.108"
  }
}
