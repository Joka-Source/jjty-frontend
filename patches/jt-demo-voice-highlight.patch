+// jt-water (vendored) — glide through a viscous medium.
+// Built from jt-water@0.1.0 (src/medium.ts + src/glide.ts, compiled to JS).
+// Do not edit here; edit in the jt-water repo and re-vendor.
+//
+// Model: critically damped motion, x'' = -omega^2 (x - to) - 2 omega x',
+// closed form x(t) = to + (A + B t) e^(-omega t) with an entry impulse
+// v0 = -entry * omega * A (entry < 1 => zero overshoot, analytically).
+
+export const WATER = Object.freeze({
+  viscosity: 1,
+  tension: 170,
+  entry: 0.85,
+  drag: 6,
+});
+
+export const REST_EPSILON = 0.05;
+
+export function omegaOf(m) {
+  return Math.sqrt(m.tension) / m.viscosity;
+}
+
+function settlingTime(A, B, omega, eps) {
+  if (Math.abs(A) < eps) return 0;
+  const a = Math.abs(A);
+  const b = Math.abs(B);
+  let t = Math.log(Math.max(a / eps, Math.E)) / omega;
+  for (let i = 0; i < 40; i++) {
+    const e = Math.exp(-omega * t);
+    const f = (a + b * t) * e - eps;
+    const df = (b - omega * (a + b * t)) * e;
+    if (df >= 0) {
+      t += 1 / omega;
+      continue;
+    }
+    const next = t - f / df;
+    if (!Number.isFinite(next) || next < 0) break;
+    if (Math.abs(next - t) < 1e-6) return next;
+    t = next;
+  }
+  return t;
+}
+
+export function glide(from, to, m = WATER) {
+  const omega = omegaOf(m);
+  const A = from - to;
+  const B = (1 - m.entry) * omega * A;
+  const duration = settlingTime(A, B, omega, REST_EPSILON);
+  return Object.freeze({
+    from,
+    to,
+    omega,
+    duration,
+    at(t) {
+      if (t <= 0) return { x: from, v: -m.entry * omega * A, done: A === 0 };
+      const e = Math.exp(-omega * t);
+      const x = to + (A + B * t) * e;
+      const v = (B - omega * (A + B * t)) * e;
+      const done = t >= duration;
+      return { x: done ? to : x, v: done ? 0 : v, done };
+    },
+  });
+}
